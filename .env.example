# Copy this file to .env and fill in the values:  cp .env.example .env

# ---------------- Server ----------------
# 5001, because the AuthCore backend uses 5000
PORT=5001
NODE_ENV=development

# Frontend URL (the "demo front" React app): allowed by CORS, and where people land after signing in
CLIENT_URL=http://localhost:5500

# ---------------- Database (MongoDB Atlas) ----------------
# Atlas: Connect -> Drivers. Add the database name (demo_auth) after ".mongodb.net/"
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/demo_auth?retryWrites=true&w=majority

# ---------------- Sign-in: AuthCore single sign-on ----------------
# This app must be registered in AuthCore (Applications). The seeded "Demo App" is:
# `npm run db:seed` in the AuthCore backend prints its client ID (and the client
# secret, unless SEED_DEMO_APP_CLIENT_SECRET is set there). The server won't start
# until all of these are set.
AUTHCORE_URL=http://localhost:5000
AUTHCORE_CLIENT_ID=
AUTHCORE_CLIENT_SECRET=
# Must match a Redirect URI registered for this app in AuthCore exactly
AUTHCORE_REDIRECT_URI=http://localhost:5001/api/auth/callback
# Also register this app's back-channel logout URL in AuthCore (the seeded Demo App has it):
#   http://localhost:5001/api/auth/backchannel-logout
# AuthCore calls it when someone logs out anywhere, so this app ends their session at once.
# At least 32 characters; encrypts this app's session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
