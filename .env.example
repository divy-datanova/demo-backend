# Copy this file to .env and fill in the values:  cp .env.example .env

# ---------------- Server ----------------
PORT=5000
NODE_ENV=development

# Frontend URL (the "demo front" React app): allowed by CORS and used for redirects after Google login
CLIENT_URL=http://localhost:5500

# ---------------- Database (MongoDB Atlas) ----------------
# Atlas: Connect -> Drivers. Add the database name (demo_auth) after ".mongodb.net/"
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/demo_auth?retryWrites=true&w=majority

# ---------------- Auth (JWT) ----------------
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# ---------------- Default user (seeded on startup) ----------------
DEFAULT_USER_EMAIL=yug@gmail.com
DEFAULT_USER_PASSWORD=change_me

# ---------------- Google Login (OAuth 2.0) ----------------
# From https://console.cloud.google.com/apis/credentials -> OAuth client ID (Web application)
# "Authorized redirect URIs" in Google must contain exactly GOOGLE_CALLBACK_URL below.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
